<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
<script src="https://unpkg.com/babel-standalone@6/babel.min.js"></script>
<%@ include file="/WEB-INF/views/chat.jsp" %>
<footer>
	<div id="area_footer">
		<div id="areaTop_footer">
			<div id="areaTop_left"><a href="/mingle/home" id="footer_logo">mingle</a></div>
			<div id="areaTop_middle">
				<div><a href="">Price</a></div>
				<div><a href="">About</a></div>
				<div><a href="">Support</a></div>
				<div><a href="">Features</a></div>
			</div>
			<div id="areaTop_right">
				<div id="areaTop_right_wrapper">
					<div><a href=""><img src="/mingle/img/home/icon_instagram.png"></a></div>
					<div><a href=""><img src="/mingle/img/home/icon_facebook.png"></a></div>
					<div><a href=""><img src="/mingle/img/home/icon_twitter.png"></a></div>
				</div>
			</div>
		</div>
		<div id="areaBottom_footer">
			<div id="areaBottom_annotation">Copyright @2020-2023 mingle 저작권법의 보호를 받습니다.</div>
		</div>
	</div>
	<div id="area_sideBtn">
		<div id="container_sideBtn">
			<c:choose>
				<c:when test="${empty authUser }">
					<a href="/mingle/user/login_joinForm" class="sideBtn" id="sideBtn_1">🤬<span class="sideBtn_text" id="sideBtn_text_1">Chat to <span>customer</span></span></a>
				</c:when>
				<c:otherwise>
					<div class="sideBtn" id="sideBtn_1" onclick="showChat()">🤬<span class="sideBtn_text" id="sideBtn_text_1">Chat to <span>customer</span></span></div>
				</c:otherwise> 
			</c:choose>
			<div class="sideBtn" id="sideBtn_2"><img id="cart_btn" src="/mingle/img/home/cart.png"/><span class="sideBtn_text">Go to cart</span></div>
			<div class="sideBtn" id="sideBtn_3"><img src="/mingle/img/home/icon_top.png"/><span class="sideBtn_text">Move to top</span></div>
		</div>
	</div>
</footer>
</div>
</body>
</html>